# Docker Hub tag verified on 2026-10-01; amd64 and arm64 are available.
ONLYOFFICE_IMAGE=onlyoffice/documentserver:9.4.0.1
# Generate with: openssl rand -hex 32
# Paste the identical generated value in the website's Office admin settings.
JWT_SECRET=
# Leave false when Document Server accesses the website over public HTTPS.
ALLOW_PRIVATE_IP_ADDRESS=false
